# ==========================================
# skill-xiaohongshu-opencli-fetcher 环境变量配置
# 本技能核心调度引擎为 ServiceHub 会员专享
# ==========================================

# 1. ServiceHub 远程服务器地址 (默认本地或您的线上域名)
SERVICEHUB_BASE_URL=http://localhost:8000

# 2. ServiceHub 注册会员用户名与密码/Token
SERVICEHUB_USERNAME=your_registered_username
SERVICEHUB_PASSWORD=your_registered_password_or_token
